<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DesktopPet.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- i18n 词条：由 scripts/extract-i18n.py 从 windows/src/i18n.ts 生成 -->
    <!-- WithCulture=false：文件名含语言段（zh/vi）会被误判为卫星资源 -->
    <EmbeddedResource Include="Resources/i18n.*.json" WithCulture="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
  </ItemGroup>

</Project>
