<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DesktopPet.Core\DesktopPet.Core.csproj" />
    <ProjectReference Include="..\DesktopPet.Infra\DesktopPet.Infra.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.WPF" Version="2.1.4" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
  </ItemGroup>

  <ItemGroup>
    <!-- 弹幕层（Phase 5）：Win2D GPU 合成 via WinUI3 XAML Islands；self-contained 免装系统运行时 -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.240923002" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.3.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AppxBundlePlatforms>x64</AppxBundlePlatforms>
    <PlatformTarget>x64</PlatformTarget>
    <EnableCoreMrtTooling>false</EnableCoreMrtTooling>
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>

</Project>
